NODE_ENV=development

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=elecscan
POSTGRES_PASSWORD=elecscan
POSTGRES_DB=elecscan
DATABASE_URL=postgresql://elecscan:elecscan@localhost:5432/elecscan?schema=public

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

NATS_URL=nats://localhost:4222

MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=elecscan
MINIO_SECRET_KEY=elecscan-secret
MINIO_BUCKET=elecscan-dev

JWT_ACCESS_SECRET=change-me-in-production-32-chars-min
JWT_REFRESH_SECRET=change-me-in-production-32-chars-min
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAMESPACE=elecscan

API_GATEWAY_PORT=4000
IAM_SERVICE_PORT=4001
DEVICE_SERVICE_PORT=4002
CONNECTOR_SERVICE_PORT=4003
INGEST_SERVICE_PORT=4004
HISTORIAN_SERVICE_PORT=4005
EVENT_DETECTION_SERVICE_PORT=4006
ALARM_SERVICE_PORT=4007
REPORTING_SERVICE_PORT=4008
GEO_SERVICE_PORT=4009
AUDIT_SERVICE_PORT=4010
NOTIFICATION_SERVICE_PORT=4011

WEB_PORT=3000

# Demo seed (cargada por `pnpm seed:demo`).
# El web /login espera estas credenciales tras correr el seed.
DEMO_TENANT_ID=11111111-1111-4111-8111-111111111111
DEMO_USER_EMAIL=demo@elecscan.local
DEMO_USER_PASSWORD=demo-password-12345

# URLs internas que el web consume (build-time pueden necesitar NEXT_PUBLIC_*).
NEXT_PUBLIC_IAM_BASE_URL=http://localhost:4001
NEXT_PUBLIC_DEVICE_BASE_URL=http://localhost:4002
