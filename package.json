{
  "name": "elecscan-enterprise",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.11.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --concurrency=20",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:cov": "turbo run test:cov",
    "test:e2e": "turbo run test:e2e",
    "clean": "turbo run clean && rm -rf node_modules",
    "compose:up": "docker compose -f infra/compose/docker-compose.dev.yml up -d",
    "compose:down": "docker compose -f infra/compose/docker-compose.dev.yml down",
    "compose:logs": "docker compose -f infra/compose/docker-compose.dev.yml logs -f",
    "prepare": "node -e \"if (!process.env.CI) require('child_process').execSync('lefthook install', {stdio: 'inherit'})\""
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.16",
    "@commitlint/cli": "21.0.2",
    "@commitlint/config-conventional": "21.0.2",
    "lefthook": "2.1.9",
    "turbo": "2.9.18",
    "typescript": "6.0.3"
  }
}
