{
  "title": "ElecScan - Service Overview",
  "uid": "elecscan-overview",
  "schemaVersion": 39,
  "version": 1,
  "tags": ["elecscan", "platform"],
  "timezone": "browser",
  "time": { "from": "now-1h", "to": "now" },
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Services up",
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "targets": [{ "expr": "count(up{job=~\".*-service|api-gateway\"} == 1)", "refId": "A" }],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 1 },
              { "color": "green", "value": 10 }
            ]
          }
        }
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "HTTP request rate (req/s)",
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "gridPos": { "h": 8, "w": 18, "x": 6, "y": 0 },
      "targets": [
        {
          "expr": "sum by (job) (rate(http_server_requests_total[1m]))",
          "refId": "A",
          "legendFormat": "{{job}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Modbus polling rate by device",
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "sum by (device_id) (rate(elecscan_modbus_read_total[1m]))",
          "refId": "A",
          "legendFormat": "{{device_id}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Modbus errors by code",
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "sum by (error_code) (rate(elecscan_modbus_errors_total[5m]))",
          "refId": "A",
          "legendFormat": "code {{error_code}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "logs",
      "title": "Recent error logs (Loki)",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 16 },
      "targets": [
        { "expr": "{namespace=\"elecscan\"} |= \"level\\\":\\\"error\\\"\"", "refId": "A" }
      ]
    }
  ]
}
